CREATE TABLE IF NOT EXISTS agent.users (
                    id BIGSERIAL PRIMARY KEY,
                    user_key TEXT UNIQUE NOT NULL,
                    username TEXT,
                    email TEXT,
                    password_hash TEXT,
                    user_group TEXT DEFAULT 'amazon',
                    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
                );

